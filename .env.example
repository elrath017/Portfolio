# Application Secret Key for Flask Session Signing
SECRET_KEY=generate-a-strong-random-secret-key-here

# Admin Password for managing portfolio content
ADMIN_PASSWORD=your-password

# Gemini AI API Key (Get from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your-api-key

# Gemini Model Name (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Flask Server Config
FLASK_PORT=5000
FLASK_DEBUG=False
